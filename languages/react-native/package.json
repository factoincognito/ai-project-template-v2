{
  "name": "[project-name]",
  "version": "0.1.0",
  "description": "[project-description]",
  "private": true,
  "main": "src/index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test": "jest --coverage",
    "lint": "biome check .",
    "format": "biome format --write .",
    "ci": "biome ci --error-on-warnings . && npm run typecheck && jest --coverage --coverageThreshold='{\"global\":{\"lines\":80}}'"
  },
  "dependencies": {
    "expo": "57.0.26",
    "expo-status-bar": "57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "19.2.18",
    "jest": "29.7.0",
    "jest-expo": "57.0.5",
    "test-renderer": "1.2.0",
    "typescript": "6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.expo/",
      "/android/",
      "/ios/",
      "/dist/"
    ],
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.test.{ts,tsx}",
      "!src/index.ts"
    ]
  }
}
