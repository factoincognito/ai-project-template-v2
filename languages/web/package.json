{
  "name": "[project-name]",
  "version": "0.1.0",
  "description": "[project-description]",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "jest --coverage",
    "test:e2e": "npm run build && playwright test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "ci": "biome ci . && npm run typecheck && jest --coverage --coverageThreshold='{\"global\":{\"lines\":80}}' && npm run test:e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@playwright/test": "1.56.1",
    "@types/jest": "29.5.14",
    "jest": "29.7.0",
    "ts-jest": "29.2.5",
    "typescript": "5.7.3",
    "vite": "8.3.1",
    "vite-plugin-singlefile": "2.3.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testPathIgnorePatterns": ["/node_modules/", "/dist/", "/e2e/"],
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.test.ts",
      "!src/main.ts",
      "!src/vite-env.d.ts"
    ]
  }
}
