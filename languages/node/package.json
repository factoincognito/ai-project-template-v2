{
  "name": "[project-name]",
  "version": "0.1.0",
  "description": "[project-description]",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "jest --coverage",
    "lint": "biome check .",
    "format": "biome format --write .",
    "ci": "biome ci --error-on-warnings . && npm run typecheck && jest --coverage --coverageThreshold='{\"global\":{\"lines\":80}}'"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "jest": "30.5.2",
    "@types/jest": "30.0.0",
    "ts-jest": "29.4.14",
    "typescript": "6.0.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ],
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.test.ts"
    ]
  }
}
